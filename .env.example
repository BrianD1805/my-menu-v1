NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
ORDUVA_ADMIN_USERNAME=your_admin_username
ORDUVA_ADMIN_PASSWORD=your_admin_password

# Phase 2 owner login
ORDUVA_AUTH_SECRET=replace-with-a-long-random-secret

# Shared admin domain
ADMIN_HOSTNAME=admin.orduva.com
NEXT_PUBLIC_ADMIN_HOSTNAME=admin.orduva.com

# Live web push for installed admin PWA
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@example.com

# Client onboarding email / launch notification foundation
# Ver-0.150 adds an owner admin test panel under Admin > Settings.
# If left blank, onboarding still works and email events are logged as skipped.
RESEND_API_KEY=
ORDUVA_EMAIL_FROM=Orduva <hello@orduva.com>
ORDUVA_OWNER_EMAIL=owner@example.com
