NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
ORDUVA_ADMIN_USERNAME=your_admin_username
ORDUVA_ADMIN_PASSWORD=your_admin_password

# Phase 2 owner login
ORDUVA_AUTH_SECRET=replace-with-a-long-random-secret

# Shared admin domain
ADMIN_HOSTNAME=admin.orduva.com
NEXT_PUBLIC_ADMIN_HOSTNAME=admin.orduva.com

# Live web push for installed admin PWA
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@example.com

# Client onboarding email / launch notification foundation
# Ver-0.150 adds an owner admin test panel under Admin > Settings.
# If left blank, onboarding still works and email events are logged as skipped.
RESEND_API_KEY=
ORDUVA_EMAIL_FROM=Orduva <hello@orduva.com>
ORDUVA_OWNER_EMAIL=owner@example.com

# Stripe checkout foundation (Ver-0.190)
# Create one recurring Stripe Price for every plan/currency/interval combination.
# Billing intervals use monthly/yearly to match Orduva plan selection.
STRIPE_SECRET_KEY=sk_test_or_live_key_here
NEXT_PUBLIC_SITE_URL=https://www.orduva.com
ORDUVA_STRIPE_SUCCESS_URL=https://admin.orduva.com/billing/success
ORDUVA_STRIPE_CANCEL_URL=https://admin.orduva.com/billing/cancel

STRIPE_PRICE_STARTER_ZAR_MONTHLY=
STRIPE_PRICE_STARTER_ZAR_YEARLY=
STRIPE_PRICE_GROWTH_ZAR_MONTHLY=
STRIPE_PRICE_GROWTH_ZAR_YEARLY=
STRIPE_PRICE_PRO_ZAR_MONTHLY=
STRIPE_PRICE_PRO_ZAR_YEARLY=

STRIPE_PRICE_STARTER_KES_MONTHLY=
STRIPE_PRICE_STARTER_KES_YEARLY=
